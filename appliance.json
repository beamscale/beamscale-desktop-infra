      "promoted": false
    },
    {
      "name": "supervisor",
      "repo": "beamscale/bmscl-supervisor",
      "rev": "bd92f030e844d4f8a723885b5250da65a7043a2a",
      "kind": "erlang",
      "promoted": false
    },
    {
      "name": "compiler",
      "repo": "beamscale/bmscl-compiler",
      "rev": "b539cc31d814d78a0c34604762c5060c9ad27e34",
      "kind": "rust",
      "promoted": true
    },
    {
      "name": "cli",
      "repo": "beamscale/bmscl-cli",
      "rev": "4b959e8e7c039da8d9a3251b02cb638e2c6848b1",
      "kind": "rust",
      "promoted": false,
      "role": "end-user-cli"
    }
  ],
  "clients": [
    {
      "name": "cli-gleam",
      "repo": "beamscale/bmscl-cli-gleam",
