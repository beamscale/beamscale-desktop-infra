[Unit]
Description=BeamScale Desktop Daemon
After=network-online.target

[Service]
Type=simple
ExecStart=%h/.local/bin/beamscale-desktop-daemon
Restart=on-failure
RestartSec=2
NoNewPrivileges=true
PrivateTmp=true
ProtectSystem=strict
ProtectHome=read-only
ReadWritePaths=%h/.beamscale
RestrictAddressFamilies=AF_UNIX AF_INET AF_INET6

[Install]
WantedBy=default.target
