      "promoted": false,
      "role": "internal-operator-cli"
    },
    {
      "name": "flutter",
      "repo": "beamscale/bmscl-flutter",
      "rev": "eb16b1862ad2026e04d62fcdc469f6acfc196ed2",
      "promoted": false
    },
    {
      "name": "desktop-rust",
      "repo": "beamscale/bmscl-desktop-app.rs",
      "rev": "778cb7e04ccb6c31f4e6048cb83e6d10f6707fe5",
      "promoted": false
    }
  ],
  "cloudflare": {
    "origin": "http://127.0.0.1:8080",
    "credentials_in_repo": false,
    "mode": "gated",
    "token_source": "file",
    "token_file_env": "BMSCL_CF_TUNNEL_TOKEN_FILE",
    "hostname_env": "BMSCL_TUNNEL_HOSTNAME",
    "hostname_template": "<installation-id>.<configured-zone>",
    "ingress_paths": [
      "/"
    ],
    "public_ingress_ready": false,
    "origin_auth": "dedicated-remote-auth-required",
    "promotion_reason": "The declared public BEAM ingress is not yet started by the ores-compose local graph; keep tunnel promotion blocked until origin lifecycle and dedicated remote authentication are wired."
  },
  "update": {
    "mode": "exact-revision",
    "allow_mutable_latest": false,
    "rollback": "previous-manifest"
  },
  "promotion_gates": {
    "private_repo_ci_evidence": false,
    "desktop_ingress_ci_green": false,
    "public_ingress_ready": false,
    "daemon_lockfile_committed": false,
    "common_layer_pinned": true,
    "common_layer_ci_verified": false
  },
  "cli_profiles": {
    "end_user": {
      "command": "bmscl",
      "implementation": "rust",
      "source": "components/cli",
      "audience": "external"
    },
    "internal_operator": {
      "command": "bmscl-internal",
      "implementation": "gleam",
      "source": "clients/cli-gleam",
      "audience": "internal"
    }
  },
  "orchestrator": {
    "engine": "ores-compose",
    "config": ".ores-compose.yaml",
    "public_config": null,
    "source_role": "desktop-daemon",
    "shutdown_timeout_ms": 5000
  },
  "common_layer": {
    "repository": "ORESoftware/ores-common-desktop-infra",
    "checkout_dir": "tmp/dev/ores-common-desktop-infra",
    "status": "pinned",
    "revision": "c98aee842535429bc07b5e4437a2fb84d8f00d25",
    "capabilities": [
      "consumer-validation",
      "loopback-policy",
      "secret-file-policy",
      "cloudflare-policy",
      "update-policy",
      "process-lifecycle",
      "health-readiness",
      "structured-logging",
      "desktop-auth-shell",
      "mixed-compute-plane",
      "runtime-isolation",
      "stable-ingress",
      "cross-platform-packaging",
      "typed-mutation-auth",
      "middleware-executor-isolation",
      "runtime-adapter-abi",
      "immutable-deployment-bundle",
      "durable-generation-state",
      "desktop-event-stream",
      "conformance-suite",
      "hot-reload-backends"
    ]
  },
  "hot_reload_policy": "hot-reload-policy.json"
}
