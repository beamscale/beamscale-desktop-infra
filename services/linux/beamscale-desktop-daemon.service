[Unit]
Description=BeamScale Desktop Daemon
After=network-online.target

[Service]
Type=simple
Environment=BMSCL_DAEMON_LISTEN=127.0.0.1:9587
ExecStart=%h/.local/share/beamscale-desktop/bin/beamscale-desktop-daemon
Restart=on-failure
RestartSec=2
NoNewPrivileges=true
PrivateTmp=true
ProtectSystem=strict
ProtectHome=read-only
ReadWritePaths=%h/.beamscale %h/.local/share/beamscale-desktop

[Install]
WantedBy=default.target
