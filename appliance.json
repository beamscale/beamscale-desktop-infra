{
  "schema": "ores.desktop-appliance/v1",
  "product": "beamscale",
  "channel": "candidate",
  "host": {
    "trust_model": "developer-owned-trusted-host",
    "daemon_listen": "127.0.0.1:9587",
    "public_origin": "http://127.0.0.1:8080",
    "default_reverse_proxy": "none",
    "requires_public_ip": false
  },
  "components": [
    {
      "name": "desktop-daemon",
      "repo": "beamscale/beamscale-desktop-daemon",
      "rev": "61db556c5d2f4258dbcdad2157b7b117afcedd4e",
      "kind": "rust",
      "promoted": false
    },
    {
      "name": "supervisor",
      "repo": "beamscale/bmscl-supervisor",
      "rev": "bf471b312ba2716fcabd58fb99843a71577b3dff",
      "kind": "erlang",
      "promoted": false
    },
    {
      "name": "compiler",
      "repo": "beamscale/bmscl-compiler",
      "rev": "c21bc0b42962da820a631e63a24965782ec0bf0e",
      "kind": "rust",
      "promoted": true
    },
    {
      "name": "cli",
      "repo": "beamscale/bmscl-cli",
      "rev": "91c54e4aad183360b5cdcdb7984aeea438d12f7b",
      "kind": "rust",
      "promoted": false,
      "role": "end-user-cli"
    }
  ],
  "clients": [
    {
      "name": "cli-gleam",
      "repo": "beamscale/bmscl-cli-gleam",
      "rev": "fea69e1520e658175ed45ec02a4604a152cd89b3",
      "promoted": false,
      "role": "alternate-end-user-cli"
    },
    {
      "name": "flutter",
      "repo": "beamscale/bmscl-flutter",
      "rev": "ef46b0b2acd9a487f6783116e8c80ef730451053",
      "promoted": false
    },
    {
      "name": "desktop-rust",
      "repo": "beamscale/bmscl-desktop-app.rs",
      "rev": "2f82d38f693877a5b600c928cf71caab3ebd6a26",
      "promoted": false
    }
  ],
  "cloudflare": {
    "origin": "http://127.0.0.1:8080",
    "credentials_in_repo": false,
    "mode": "gated",
    "token_source": "file",
    "token_file_env": "BMSCL_CF_TUNNEL_TOKEN_FILE",
    "hostname_env": "BMSCL_TUNNEL_HOSTNAME",
    "hostname_template": "<installation-id>.<configured-zone>",
    "ingress_paths": [
      "/"
    ],
    "public_ingress_ready": false,
    "origin_auth": "dedicated-remote-auth-required",
    "promotion_reason": "The same-BEAM loopback ingress now exists, but public promotion remains blocked until exact-head CI/release evidence and the dedicated remote-auth boundary are executed and promoted."
  },
  "quota_admission_profile": "quota-admission.json",
  "update": {
    "mode": "exact-revision",
    "allow_mutable_latest": false,
    "rollback": "previous-manifest"
  },
  "promotion_gates": {
    "private_repo_ci_evidence": false,
    "desktop_ingress_ci_green": false,
    "public_ingress_ready": false,
    "daemon_lockfile_committed": true,
    "common_layer_pinned": true,
    "common_layer_ci_verified": false,
    "compiler_lockfile_committed": false,
    "cli_lockfile_committed": false,
    "quota_admission_wired": false,
    "operator_service_authority_wired": false,
    "bounded_child_logs_wired": false
  },
  "cli_profiles": {
    "end_user": {
      "command": "bmscl",
      "implementation": "rust",
      "source": "components/cli",
      "audience": "external",
      "canonical": true
    },
    "alternate_end_user": {
      "command": "bmscl-gleam",
      "implementation": "gleam",
      "source": "clients/cli-gleam",
      "audience": "external",
      "canonical": false,
      "install": "optional"
    }
  },
  "orchestrator": {
    "engine": "ores-compose",
    "config": ".ores-compose.yaml",
    "public_config": null,
    "source_role": "desktop-daemon",
    "shutdown_timeout_ms": 5000
  },
  "common_layer": {
    "repository": "ORESoftware/ores-common-desktop-infra",
    "checkout_dir": "tmp/dev/ores-common-desktop-infra",
    "status": "pinned",
    "revision": "21851fcb6ca59fe4cfe887d882dac78d90548ce4",
    "capabilities": [
      "cloudflare-policy",
      "conformance-suite",
      "consumer-validation",
      "cross-platform-packaging",
      "desktop-auth-shell",
      "desktop-event-stream",
      "durable-generation-state",
      "generation-model",
      "health-readiness",
      "hot-reload-backends",
      "immutable-deployment-bundle",
      "loopback-policy",
      "middleware-executor-isolation",
      "mixed-compute-plane",
      "process-lifecycle",
      "quota-admission",
      "release-activation-policy",
      "runtime-adapter-abi",
      "runtime-isolation",
      "secret-file-policy",
      "stable-ingress",
      "structured-logging",
      "typed-mutation-auth",
      "update-policy"
    ]
  },
  "hot_reload_policy": "hot-reload-policy.json",
  "service_authority": {
    "owner": "desktop-daemon",
    "transport": "operator-authenticated-loopback-rpc",
    "operator_token_file": "operator-token",
    "service_helper": "daemon-packaged-sibling",
    "client_helper_execution": false,
    "client_helper_selection": false,
    "client_service_argv": false,
    "mutation_idempotency": true,
    "mutation_maintenance_gate": true,
    "install_mode": "register-without-competing-start",
    "uninstall_preserves_current_daemon": true
  },
  "child_logs": {
    "owner": "desktop-daemon",
    "retention_hours": 6,
    "max_segment_bytes": 4194304,
    "max_parts_per_hour_per_stream": 4,
    "components": [
      "runtime",
      "tunnel"
    ],
    "streams": [
      "stdout",
      "stderr"
    ],
    "unix_directory_mode": "0700",
    "unix_file_mode": "0600",
    "raw_log_api": false,
    "drain_after_storage_saturation": true
  }
}
